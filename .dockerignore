# TODO (CP2): file này quyết định thứ KHÔNG được copy vào image.
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.
# Bổ sung đủ các mục còn thiếu — xem tests/test_cp2.py để biết yêu cầu.

.git
.gitignore

# Secret — không bao giờ được nằm trong image
.env
.env.*

# Môi trường ảo và cache của Python/công cụ
.venv
venv
**/__pycache__
**/*.pyc
.pytest_cache
.mypy_cache
.ruff_cache

# Không cần để chạy app
tests
screenshots
*.md
.DS_Store
